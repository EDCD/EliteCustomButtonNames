<!-- VKB STECS Regular Throttle System MAX (Left) -->
<!-- (no button substitutions)-->
<!-- 1. BRK = 5-way -->
<!-- 2. MB1 = mini-stick -->
<!-- 3. RADIO = 3-way -->
<!-- 4. MB2 = 5-way -->
<!-- 5. OP EXEC = 1 way Button -->
<!-- 6. OTS = 5-way -->
